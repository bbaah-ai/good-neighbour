# --- The Good Neighbour: environment template -------------------------------
# Copy to good_neighbour/.env (next to agent.py — ADK loads it from there).
# NEVER commit the real .env. Secrets may also come from Secret Manager (see
# good_neighbour/secrets.py); any value set here as an env var takes precedence.

# Mode A — Google AI Studio (fastest local setup)
GOOGLE_GENAI_USE_ENTERPRISE=FALSE
GOOGLE_API_KEY=

# Mode B — Vertex AI (uncomment, after `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_ENTERPRISE=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# AGENT_ENGINE_ID=1234567890            # enables Vertex AI Sessions + Memory Bank

# Model routing (defaults shown)
GN_FAST_MODEL=gemini-2.5-flash
GN_REASONING_MODEL=gemini-2.5-pro

# Local persistence (SQLite by default; any SQLAlchemy async URL works)
GN_SESSION_DB_URL=sqlite+aiosqlite:///./good_neighbour_sessions.db

# Policy knobs
GN_AUTO_DISPATCH_MAX_MEALS=20
GN_DEFAULT_RADIUS_KM=5

# Observability
GN_LOG_LEVEL=INFO
GN_TRACE_EXPORTER=console              # console | gcp | none
